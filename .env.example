# Copy to .env and adjust. Never commit .env.
# Every value here is infrastructure configuration. No business taxonomy lives in
# environment variables either.

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_password
POSTGRES_DB=crm
POSTGRES_PORT=5432

# Async DSN used by the API (SQLAlchemy asyncpg driver).
# Inside docker-compose the host is `postgres`; from the host machine it is `localhost`.
DATABASE_URL=postgresql+asyncpg://crm:crm_local_password@localhost:5432/crm
DATABASE_ECHO=false

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, any S3-compatible service elsewhere) ----
MINIO_ROOT_USER=crm_minio_user
MINIO_ROOT_PASSWORD=crm_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=crm_minio_user
S3_SECRET_ACCESS_KEY=crm_minio_password
S3_BUCKET=crm-attachments
S3_REGION=us-east-1

# --- Auth ------------------------------------------------------------------
# Signs access tokens. Minimum 32 characters, and the API refuses to boot
# without it — a deployment must never fall back to a guessable default.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Login throttling, counted per email and per client IP.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Refresh throttling, counted per presented token and per client IP.
# A refresh token is legitimately presented exactly once, so the per-token
# budget can be tight. The per-IP budget is a DoS backstop and must stay
# generous — an office behind one NAT address shares it.
REFRESH_RATE_LIMIT_ATTEMPTS=10
REFRESH_RATE_LIMIT_IP_ATTEMPTS=120
REFRESH_RATE_LIMIT_WINDOW_SECONDS=300

# Argon2id cost. Raise ARGON2_MEMORY_COST_KIB on a larger production host.
ARGON2_TIME_COST=1
ARGON2_MEMORY_COST_KIB=47104
ARGON2_PARALLELISM=1

# --- API -------------------------------------------------------------------
API_PORT=8000
# A browser treats localhost and 127.0.0.1 as distinct origins; allow both locally.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Web -------------------------------------------------------------------
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --- Outbound email (M8) ------------------------------------------------------
# Leave SMTP_HOST empty in development. With no host the sender records what it
# would have sent rather than delivering it, so a local stack holding a copy of
# production-shaped data cannot mail a real customer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@example.invalid

# --- Bolna voice integration (Phase 2) ---------------------------------------
# All optional. Leave BOLNA_API_KEY unset and the voice-call endpoints answer
# 422 voice_not_configured; nothing else in the CRM is affected, and the API
# still boots. Never commit a real key — this file is the example, not the
# config.
BOLNA_API_KEY=bn-916f7674acc04993b469630524153ce0
BOLNA_BASE_URL=https://api.bolna.ai
# The Bolna agent calls are placed through. Overridable per call.
BOLNA_AGENT_ID=c6f87fbb-4ee0-4ee8-8b3d-0145da1ce521
BOLNA_REQUEST_TIMEOUT_SECONDS=15
# Optional: the name of the Bolna disposition carrying the call summary, if the
# agent uses one. Unset means the receiver reads the payload's own `summary`
# key. Deliberately has no default — a disposition name is the customer's own
# vocabulary and the product must not ship a guess at it.
BOLNA_SUMMARY_DISPOSITION=
# How the completion webhook identifies the customer. Both default true, which
# is what a real inbound or dashboard-started call needs: such a call carries no
# crm_lead_id, so the phone number is the only identifier available.
# Set BOLNA_MATCH_BY_PHONE=false to restore the stricter behaviour in
# docs/06 §5 (id-only matching) — required if you ever expose an
# unauthenticated webhook route.
BOLNA_MATCH_BY_PHONE=true
BOLNA_CREATE_MISSING_LEADS=true
# Optional defence in depth for the URL-key webhook route. Bolna delivers from
# a single documented source IP. Comma-separated; empty disables the check.
# Leave empty behind a proxy that rewrites the peer address unless it sets
# X-Forwarded-For.
BOLNA_WEBHOOK_ALLOWED_IPS=

# --- Tally form intake --------------------------------------------------------
# Optional. Tally can sign each webhook with a shared secret; set the same value
# here and `POST /api/v1/intake/tally` verifies `tally-signature` over the raw
# request body. Empty means the signature is not checked — the API key is the
# actual credential either way, and requiring a secret nobody configured would
# refuse every real submission.
TALLY_SIGNING_SECRET=
